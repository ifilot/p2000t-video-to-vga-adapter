/* Embedded RGB444 no-connection artwork. Generated by CMake so .incbin can
 * use an absolute source path while keeping the binary itself in assets/. */

    .section .rodata.@NO_CONNECTION_IMAGE_SYMBOL@,"a",%progbits
    .balign 4
    .global @NO_CONNECTION_IMAGE_SYMBOL@
    .type @NO_CONNECTION_IMAGE_SYMBOL@, %object
@NO_CONNECTION_IMAGE_SYMBOL@:
    .incbin "@NO_CONNECTION_IMAGE_SOURCE@"
    .size @NO_CONNECTION_IMAGE_SYMBOL@, . - @NO_CONNECTION_IMAGE_SYMBOL@

    .section .note.GNU-stack,"",%progbits
