;
; @file p2000t_capture.pio
; @brief Frame- and line-locked 12 MHz sampling of conditioned P2000T RGBS.
;
; Pin contract:
;   IN base covers GP16..GP19; each IN stores one four-bit RGBS sample.
;   JMP pin is configured at runtime to the mapped conditioned CSYNC input.
;   Conditioned CSYNC is active high; conditioned RGB is active low.
;
; Clock and packing contract:
;   The state machine runs at 126 MHz from the 252 MHz RP2040 clock divided by
;   two. Each nominal 6 MHz source dot occupies 21 PIO cycles. The sample loop
;   takes two samples in those 21 cycles, alternating 10- and 11-cycle sample
;   intervals. Eight chronological four-bit samples auto-push one DMA word.
;   No pixel reconstruction or majority vote is performed.
;
; TX command contract for each frame:
;   1. 239: capture 240 visible lines using the Y decrementing loop.
;   2. first visible scanline minus one.
;   3. For each visible line: horizontal start delay, then 239 as the loop
;      count for 240 source dots and therefore 480 raw samples.

.program p2000t_capture

.wrap_target
    pull block
    mov y, osr                     ; 239: visible-line loop count

    ; Find a CSYNC active interval longer than 6 us. Normal horizontal pulses
    ; last approximately 4.5 us and return to the search loop. Entering during
    ; an ordinary pulse merely rejects that shortened candidate.
find_vertical_start:
    jmp pin vertical_candidate
    jmp find_vertical_start
vertical_candidate:
    set x, 31
vertical_measure:
    jmp pin vertical_continue
    jmp find_vertical_start        ; pulse ended before the threshold
vertical_continue:
    jmp x-- vertical_measure [23]  ; 32 x 25 cycles = 6.35 us
vertical_end:
    jmp pin vertical_end

    ; Count normal line-sync leading edges to the first display scanline. The
    ; command is first_visible_scanline - 1 because JMP X-- loops N+1 times.
    pull block
    mov x, osr
skip_wait_idle:
    jmp pin skip_wait_idle
skip_wait_active:
    jmp pin skip_got_edge
    jmp skip_wait_active
skip_got_edge:
    jmp x-- skip_wait_idle

    ; Anchor sampling to CSYNC. One combined programmable loop includes the
    ; former fixed 1024-cycle delay, coarse source-dot offset, fine phase, and
    ; compensation for the qualified-edge delay below.
line_start_delay:
    pull block
    mov x, osr
phase_delay_loop:
    jmp x-- phase_delay_loop
    pull block
    mov x, osr                     ; 239: source-dot pair loop count

    ; One loop is 21 ticks. Samples land at ticks 6 and 16 before the global
    ; phase adjustment, so consecutive intervals alternate between 10 and 11
    ; ticks and the average sampling rate is exactly 12 MHz.
sample_source_dot:
    nop [5]
    in pins, 4 [9]                 ; first half-dot sample: tick 6
    in pins, 4 [3]                 ; second half-dot sample: tick 16
    jmp x-- sample_source_dot

    jmp y-- next_line_wait_active
.wrap

    ; Sampling finishes about 7 us before the next expected horizontal sync.
    ; Ignore the first 4.1 us (SET plus 16 x 32-cycle loop iterations), then
    ; require a candidate pulse to remain active for another 33 PIO clocks
    ; (about 0.26 us). This rejects early or very narrow CSYNC glitches while
    ; retaining ample margin for the normal approximately 4.5 us pulse.
next_line_wait_active:
    set x, 15
horizontal_sync_holdoff:
    jmp x-- horizontal_sync_holdoff [31]
horizontal_sync_wait_active:
    jmp pin horizontal_sync_candidate
    jmp horizontal_sync_wait_active
horizontal_sync_candidate:
    nop [31]
    jmp pin line_start_delay
    jmp horizontal_sync_wait_active
