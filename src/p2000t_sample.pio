;
; Capture the four adjacent, conditioned P2000T input pins GPIO16 through
; GPIO19. Their logical RGBS assignment is selected in signal_probe.c because
; prototype v1 has a mirrored DIN mapping that will be fixed in PCB v2.
;
; Eight four-bit samples are shifted into each 32-bit RX FIFO word. DMA drains
; the FIFO so USB servicing and CPU interrupt latency cannot disturb sampling.

.program p2000t_sample

.wrap_target
    in pins, 4
.wrap
