	(text "DIN6 socket. A male-to-male DIN6 cable is used to connect this board to the P2000T."
		(exclude_from_sim no)
		(at 14.732 17.526 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "23f1338e-23d0-4b60-8bfe-a7b9c361cd1e")
	)
	(text "P2000T input conditioning: 1 kΩ resistors limit transient current, BAT54A diodes clamp negative undershoot,\nand 74LVC1G14 Schmitt-trigger inverters translate and clean the 5 V-class signals to 3.3 V RP2350 logic.\nOutputs are inverted."
		(exclude_from_sim no)
		(at 15.24 54.102 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "4ec4b3e8-8a5a-434a-a372-68d384cd8999")
	)
	(text "Pico 2 controller: GPIO16-18 capture conditioned RGBS. \nGPIO0-11 provide 4-bit-per-channel RGB VGA output, with GPIO12-13 generating VGA sync. \nRUN has a manual reset switch; unused control, ADC, and GPIO pins are left unconnected."
		(exclude_from_sim no)
		(at 128.016 18.542 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "61d48021-b9b3-49a5-97d9-49f9613e7fbb")
	)
	(text "Pico 2 is powered through onboard USB. \nPin 36 provides regulated 3.3 V to the \ninput-conditioning circuitry."
		(exclude_from_sim no)
		(at 207.772 38.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "b3be2974-ff8b-463e-a9f1-7b268c3ecd8e")
	)
